# LeadForge AI Backend Configuration
# 100% Free & Open-Source Defaults

ENVIRONMENT="development"
APP_NAME="LeadForge AI Core"
DEBUG=True
PORT=8000

# Database
DATABASE_URL="sqlite:///./leadforge.db"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# AI ENGINE CONFIGURATION (CHOOSE EITHER GEMINI OR OPENROUTER)
# ------------------------------------------------------------------------------
# Option A: Google Gemini API Key (100% Free at https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Option B: OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_MODEL="google/gemini-2.0-flash-exp:free"
OPENROUTER_FALLBACK_MODEL="meta-llama/llama-3.2-3b-instruct:free"

# ------------------------------------------------------------------------------
# BUSINESS DISCOVERY (DEFAULT: 100% FREE OPENSTREETMAP)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=""

# Crawler Settings
CRAWLER_USER_AGENT="LeadForgeBot/1.0 (+https://leadforge.internal; agency-scanner)"
CRAWLER_TIMEOUT_SECONDS=10
